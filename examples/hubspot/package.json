{
  "name": "@totem/example-hubspot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node --watch dist/server.js",
    "hs:upload": "cd totem-test && hs project upload",
    "live": "node --env-file-if-exists=.env.local dist/live.js"
  },
  "dependencies": {
    "@totem/sdk": "workspace:*",
    "effect": "^4.0.6"
  },
  "devDependencies": {
    "@totem/platform": "workspace:*",
    "@hubspot/cli": "^8.17.0",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
